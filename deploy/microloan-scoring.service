[Unit]
Description=Microloan scoring-service (Kafka consumer)
After=network-online.target kafka-container.service
Wants=network-online.target kafka-container.service

[Service]
User=microloan
WorkingDirectory=/opt/microloan
Environment=SERVER_PORT=8082
Environment=KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
ExecStart=/usr/bin/java -Xms64m -Xmx256m -jar /opt/microloan/scoring-service.jar
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
